{
  "manifest_version": 3,
  "name": "browser-use",
  "version": "0.1.0",
  "description": "Local browser agent: MCP bridge plus side-panel chat using the .env chat model.",
  "permissions": ["tabs", "activeTab", "scripting", "storage", "sidePanel", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "browser-use"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
